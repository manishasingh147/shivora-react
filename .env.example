PORT=4000
# Comma-separated if multiple origins need access (e.g. www + apex domain).
# Not needed when the API also serves the built frontend (same-origin).
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=3306
DB_USER=shivora_app
DB_PASSWORD=change-me
DB_NAME=shivora
# Most managed MariaDB/MySQL providers require this in production.
DB_SSL=false
# Optional: DB connection pool size (default 5).
# DB_POOL_SIZE=5

# Set to "production" when deployed. Enables stricter startup checks, trusts the
# first proxy hop, and switches request logging to the combined (Apache-style) format.
NODE_ENV=development
